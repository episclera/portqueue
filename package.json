{
  "name": "portqueue-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "The distributed, fault-tolerant, database-agnostic, performance-focused queue implementation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm run test --workspace @portqueue/core",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "setup": "bash scripts/dev/setup.sh",
    "cli": "bash scripts/cli/run.sh",
    "dev:docs": "bash scripts/dev/start-docs.sh",
    "db:pg:up": "bash scripts/dev/db/start-postgres.sh",
    "db:pg:down": "bash scripts/dev/db/stop-postgres.sh",
    "db:mysql:up": "bash scripts/dev/db/start-mysql.sh",
    "db:mysql:down": "bash scripts/dev/db/stop-mysql.sh",
    "db:oracle:up": "bash scripts/dev/db/start-oracle.sh",
    "db:oracle:down": "bash scripts/dev/db/stop-oracle.sh",
    "example:dashboard-node": "bash scripts/dev/examples/dashboard-node-server.sh",
    "example:dashboard-express": "bash scripts/dev/examples/dashboard-express.sh",
    "example:schedule-delayed": "bash scripts/dev/examples/job-scheduling-delayed.sh",
    "example:schedule-recurring": "bash scripts/dev/examples/job-scheduling-recurring.sh",
    "example:retries": "bash scripts/dev/examples/retries-backoff.sh",
    "example:idempotency": "bash scripts/dev/examples/idempotency-singleton.sh",
    "example:graceful": "bash scripts/dev/examples/graceful-shutdown.sh",
    "example:postgres": "bash scripts/dev/examples/postgres-connection.sh",
    "example:transactional": "bash scripts/dev/examples/transactional-enqueue.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
