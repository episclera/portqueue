{
  "name": "portqueue-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "PortQueue — a database-backed job queue for Node.js that works across multiple database engines.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm run test --workspace @portqueue/core",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "setup": "bash scripts/dev/setup.sh",
    "cli": "bash scripts/cli/run.sh",
    "dev:docs": "bash scripts/dev/start-docs.sh",
    "db:pg:up": "bash scripts/dev/start-postgres.sh",
    "db:pg:down": "bash scripts/dev/stop-postgres.sh",
    "db:oracle:up": "bash scripts/dev/start-oracle.sh",
    "db:oracle:down": "bash scripts/dev/stop-oracle.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
