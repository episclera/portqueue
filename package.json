{
  "name": "portqueue-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A horizontally scalable, fault-tolerant, database-agnostic, performance-focused queue implementation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "scripts": {
    "build": "npm run build -w @portqueue/core && npm run build -w @portqueue/dashboard && npm run build -w @portqueue/cli && npm run build -w @portqueue/ui && npm run build -w @portqueue/docs",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:core": "npm run test --workspace @portqueue/core",
    "test:mysql": "npm run test:mysql --workspace @portqueue/core",
    "test:oracle": "npm run test:oracle --workspace @portqueue/core",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "npm publish -w @portqueue/core -w @portqueue/dashboard -w @portqueue/cli",
    "semantic-release": "semantic-release",
    "setup": "bash scripts/dev/setup.sh",
    "cli": "bash scripts/cli/sqlite.sh",
    "dev:docs": "bash scripts/dev/start-docs.sh",
    "db:postgresql:up": "bash scripts/dev/db/start-postgresql.sh",
    "db:postgresql:down": "bash scripts/dev/db/stop-postgresql.sh",
    "db:mysql:up": "bash scripts/dev/db/start-mysql.sh",
    "db:mysql:down": "bash scripts/dev/db/stop-mysql.sh",
    "db:oracle:up": "bash scripts/dev/db/start-oracle.sh",
    "db:oracle:down": "bash scripts/dev/db/stop-oracle.sh",
    "example:dashboard-node": "bash scripts/dev/examples/dashboard-node-server.sh",
    "example:dashboard-express": "bash scripts/dev/examples/dashboard-express.sh",
    "example:schedule-delayed": "bash scripts/dev/examples/job-scheduling-delayed.sh",
    "example:schedule-recurring": "bash scripts/dev/examples/job-scheduling-recurring.sh",
    "example:retries": "bash scripts/dev/examples/retries-backoff.sh",
    "example:idempotency": "bash scripts/dev/examples/idempotency-singleton.sh",
    "example:graceful": "bash scripts/dev/examples/graceful-shutdown.sh",
    "example:postgresql": "bash scripts/dev/examples/postgresql-connection.sh",
    "example:transactional": "bash scripts/dev/examples/transactional-enqueue.sh"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.10.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "prettier": "^3.4.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
