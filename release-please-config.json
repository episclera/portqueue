{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bootstrap-sha": "7e260caf3c228e33995f35debf2ea91dc1b61041",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "revert", "section": "Reverts" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "refactor", "section": "Code Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "style", "section": "Styles" },
    { "type": "test", "section": "Tests" },
    { "type": "build", "section": "Build System" },
    { "type": "ci", "section": "Continuous Integration" },
    { "type": "chore", "section": "Miscellaneous Chores" }
  ],
  "packages": {
    "packages/core": { "component": "core" },
    "packages/dashboard": { "component": "dashboard" },
    "packages/cli": { "component": "cli" }
  },
  "plugins": [
    { "type": "node-workspace", "merge": false },
    {
      "type": "linked-versions",
      "groupName": "portqueue",
      "components": ["core", "dashboard", "cli"]
    }
  ]
}
