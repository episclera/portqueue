{
  "name": "@portqueue/dashboard",
  "version": "1.0.0",
  "description": "Self-hostable React dashboard middleware for PortQueue.",
  "license": "MIT",
  "homepage": "https://episclera.github.io/portqueue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/episclera/portqueue.git",
    "directory": "packages/dashboard"
  },
  "keywords": [
    "queue",
    "job-queue",
    "dashboard",
    "monitoring",
    "express",
    "koa",
    "fastify",
    "nestjs"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.client.config.ts",
    "build:server": "vite build",
    "build:client": "vite build --config vite.client.config.ts",
    "lint": "tsc --noEmit && eslint src",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --passWithNoTests",
    "test:coverage": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage --passWithNoTests"
  },
  "peerDependencies": {
    "@portqueue/core": "^0.2.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.2",
    "@portqueue/core": "*",
    "@portqueue/eslint-config": "*",
    "@portqueue/ui": "*",
    "@tanstack/react-query": "^5.62.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^15.0.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.7.9",
    "clsx": "^2.1.0",
    "eslint": "^9.17.0",
    "express": "^4.21.0",
    "fastify": "^5.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "koa": "^2.15.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^5.3.4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0"
  }
}
