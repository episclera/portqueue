{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "react"],
    "noEmit": true,
    // Typecheck-only config: the @portqueue/ui path below pulls a sibling
    // workspace's source into the program, so the common root is packages/.
    // Emit is owned by Vite (vite-plugin-dts), so rootDir has no output effect.
    "rootDir": "..",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@portqueue/ui": ["../ui/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
