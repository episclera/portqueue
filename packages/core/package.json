{
  "name": "@portqueue/core",
  "version": "1.0.2",
  "description": "A horizontally scalable, fault-tolerant, database-agnostic, performance-focused queue implementation.",
  "license": "MIT",
  "homepage": "https://episclera.github.io/portqueue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/episclera/portqueue.git",
    "directory": "packages/core"
  },
  "keywords": [
    "queue",
    "job-queue",
    "background-jobs",
    "worker",
    "scheduler",
    "cron",
    "postgresql",
    "postgres",
    "mysql",
    "oracle",
    "sqlite",
    "pglite",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./drivers/postgresql": {
      "types": "./dist/drivers/postgresql/index.d.ts",
      "import": "./dist/drivers/postgresql/index.mjs",
      "require": "./dist/drivers/postgresql/index.cjs"
    },
    "./drivers/pglite": {
      "types": "./dist/drivers/pglite/index.d.ts",
      "import": "./dist/drivers/pglite/index.mjs",
      "require": "./dist/drivers/pglite/index.cjs"
    },
    "./drivers/sqlite": {
      "types": "./dist/drivers/sqlite/index.d.ts",
      "import": "./dist/drivers/sqlite/index.mjs",
      "require": "./dist/drivers/sqlite/index.cjs"
    },
    "./drivers/oracle": {
      "types": "./dist/drivers/oracle/index.d.ts",
      "import": "./dist/drivers/oracle/index.mjs",
      "require": "./dist/drivers/oracle/index.cjs"
    },
    "./drivers/mysql": {
      "types": "./dist/drivers/mysql/index.d.ts",
      "import": "./dist/drivers/mysql/index.mjs",
      "require": "./dist/drivers/mysql/index.cjs"
    },
    "./tx": {
      "types": "./dist/tx/index.d.ts",
      "import": "./dist/tx/index.mjs",
      "require": "./dist/tx/index.cjs"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.mjs",
      "require": "./dist/conformance/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "lint": "tsc --noEmit && eslint src",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "test:mysql": "PORTQUEUE_MYSQL_URL=mysql://portqueue:portqueue@localhost:3306/portqueue node --experimental-vm-modules ../../node_modules/jest/bin/jest.js src/conformance/manual",
    "test:oracle": "PORTQUEUE_ORACLE_USER=portqueue PORTQUEUE_ORACLE_PASSWORD=portqueue PORTQUEUE_ORACLE_CONNECT=localhost:1521/FREEPDB1 node --experimental-vm-modules ../../node_modules/jest/bin/jest.js src/conformance/manual"
  },
  "dependencies": {
    "cron-parser": "^5.6.2"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "*",
    "better-sqlite3": "*",
    "mysql2": "*",
    "oracledb": "*",
    "pg": "*"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@portqueue/eslint-config": "*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "better-sqlite3": "^12.8.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "mysql2": "^3.11.0",
    "oracledb": "^6.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0"
  }
}
