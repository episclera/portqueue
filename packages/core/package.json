{
  "name": "@portqueue/core",
  "version": "0.1.0",
  "description": "Database-backed job queue for Node.js — the core engine and first-party drivers.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./drivers/postgres": {
      "types": "./dist/drivers/postgres/index.d.ts",
      "import": "./dist/drivers/postgres/index.mjs",
      "require": "./dist/drivers/postgres/index.cjs"
    },
    "./drivers/pglite": {
      "types": "./dist/drivers/pglite/index.d.ts",
      "import": "./dist/drivers/pglite/index.mjs",
      "require": "./dist/drivers/pglite/index.cjs"
    },
    "./drivers/sqlite": {
      "types": "./dist/drivers/sqlite/index.d.ts",
      "import": "./dist/drivers/sqlite/index.mjs",
      "require": "./dist/drivers/sqlite/index.cjs"
    },
    "./drivers/oracle": {
      "types": "./dist/drivers/oracle/index.d.ts",
      "import": "./dist/drivers/oracle/index.mjs",
      "require": "./dist/drivers/oracle/index.cjs"
    },
    "./tx": {
      "types": "./dist/tx/index.d.ts",
      "import": "./dist/tx/index.mjs",
      "require": "./dist/tx/index.cjs"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.mjs",
      "require": "./dist/conformance/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "lint": "tsc --noEmit && eslint src",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "*",
    "better-sqlite3": "*",
    "oracledb": "*",
    "pg": "*"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "oracledb": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@portqueue/eslint-config": "*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.4.0"
  }
}
